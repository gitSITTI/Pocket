# Copy to .env for local use. Never commit the real .env file.

# Path to the config file (default: ./pocket.config.json)
POCKET_CONFIG=./pocket.config.json

# Used only when no config file exists: a single content directory
# POCKET_CONTENT_DIR=./content

# Where pending proposals are written (default: ./.pocket/proposals)
# POCKET_PROPOSALS_DIR=./.pocket/proposals

# Set to 1 to disable add_entry / update_entry entirely (fully read-only server)
# POCKET_READ_ONLY=0
