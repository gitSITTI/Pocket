{
  "name": "pocket-bok",
  "version": "0.1.0",
  "description": "Pocket: a Pocket Body of Knowledge MCP server. File-based, git-friendly, layered, with human-approved writes.",
  "license": "Apache-2.0",
  "mcpName": "io.github.gitSITTI/pocket",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gitSITTI/Pocket.git"
  },
  "homepage": "https://github.com/gitSITTI/Pocket#readme",
  "bugs": {
    "url": "https://github.com/gitSITTI/Pocket/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema/entry.schema.json": "./schema/entry.schema.json"
  },
  "bin": {
    "pocket-bok": "dist/server.js",
    "pocket-mcp": "dist/server.js",
    "pocket": "dist/cli.js"
  },
  "files": [
    "dist",
    "schema",
    "template",
    "examples",
    "docs",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/server.js",
    "validate": "node dist/cli.js validate",
    "setup:hooks": "sh scripts/setup-hooks.sh",
    "registry:check": "node scripts/registry-metadata.mjs check",
    "smoke:semantic": "node scripts/semantic-smoke.mjs",
    "version": "node scripts/registry-metadata.mjs sync && git add server.json",
    "prepublishOnly": "npm run build && npm run registry:check"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "knowledge-base",
    "body-of-knowledge",
    "semantic-search",
    "embeddings"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@huggingface/transformers": "^4.3.1"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "ajv": "^8.20.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
